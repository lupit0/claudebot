# Proxy configuration (optional but recommended for heavy use)
# Residential proxies work best. Format: protocol://user:pass@host:port
PROXY_URL=

# Multiple proxies for rotation (comma-separated)
PROXY_POOL=

# SerpApi key (optional, for Google Flights API fallback)
SERPAPI_KEY=

# Anthropic API key (optional, for Claude-powered result analysis)
ANTHROPIC_API_KEY=

# Browser settings
HEADLESS=true
SLOW_MO=0
